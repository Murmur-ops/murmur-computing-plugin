{
  "mcpServers": {
    "murmur": {
      "command": "murmur",
      "args": ["planner", "mcp"],
      "env": {
        "PATH": "${USERPROFILE:-}/.murmur/bin;:${HOME:-}/.murmur/bin:${PATH};${PATH}"
      }
    },
    "murmur-python": {
      "command": "murmur",
      "args": ["planner", "mcp", "--python"],
      "env": {
        "PATH": "${USERPROFILE:-}/.murmur/bin;:${HOME:-}/.murmur/bin:${PATH};${PATH}"
      }
    }
  }
}
